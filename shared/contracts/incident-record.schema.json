{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": true,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^1\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "locator",
        "schema_version",
        "sha256"
      ],
      "title": "ArtifactReference",
      "type": "object"
    }
  },
  "$id": "https://schemas.agentic-studio.local/v1/incident-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "affected_gate_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Affected Gate Ids",
      "type": "array"
    },
    "containment_actions": {
      "items": {
        "type": "string"
      },
      "title": "Containment Actions",
      "type": "array"
    },
    "detected_at": {
      "format": "date-time",
      "title": "Detected At",
      "type": "string"
    },
    "evidence_references": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Evidence References",
      "type": "array"
    },
    "incident_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Incident Id",
      "type": "string"
    },
    "recovery_approval_reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "remediation_actions": {
      "items": {
        "type": "string"
      },
      "title": "Remediation Actions",
      "type": "array"
    },
    "schema_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "title": "Scope",
      "type": "string"
    },
    "status": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "incident_id",
    "detected_at",
    "scope",
    "evidence_references",
    "containment_actions",
    "remediation_actions",
    "affected_gate_ids",
    "recovery_approval_reference",
    "status"
  ],
  "title": "IncidentRecord",
  "type": "object"
}
