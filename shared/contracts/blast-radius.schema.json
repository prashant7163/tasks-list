{
  "$id": "https://schemas.agentic-studio.local/v1/blast-radius.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "affected_build_paths": {
      "items": {
        "type": "string"
      },
      "title": "Affected Build Paths",
      "type": "array"
    },
    "affected_code": {
      "items": {
        "type": "string"
      },
      "title": "Affected Code",
      "type": "array"
    },
    "affected_contracts": {
      "items": {
        "type": "string"
      },
      "title": "Affected Contracts",
      "type": "array"
    },
    "affected_owners": {
      "items": {
        "type": "string"
      },
      "title": "Affected Owners",
      "type": "array"
    },
    "affected_tests": {
      "items": {
        "type": "string"
      },
      "title": "Affected Tests",
      "type": "array"
    },
    "blast_radius_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Blast Radius Id",
      "type": "string"
    },
    "confidence": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Confidence",
      "type": "string"
    },
    "graph_fresh": {
      "title": "Graph Fresh",
      "type": "boolean"
    },
    "graph_snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Graph Snapshot Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "unknown_edges": {
      "items": {
        "type": "string"
      },
      "title": "Unknown Edges",
      "type": "array"
    },
    "verification_plan": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Verification Plan",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "blast_radius_id",
    "graph_snapshot_id",
    "graph_fresh",
    "affected_code",
    "affected_contracts",
    "affected_tests",
    "affected_owners",
    "affected_build_paths",
    "confidence",
    "unknown_edges",
    "verification_plan"
  ],
  "title": "BlastRadius",
  "type": "object"
}
