{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": true,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^1\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "locator",
        "schema_version",
        "sha256"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "AssuranceOutcome": {
      "enum": [
        "pass",
        "revision_required",
        "blocked_inconclusive"
      ],
      "title": "AssuranceOutcome",
      "type": "string"
    },
    "BuildStatus": {
      "additionalProperties": true,
      "properties": {
        "diagnostic_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "integrity_check": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Integrity Check",
          "type": "string"
        },
        "likely_cause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Likely Cause"
        },
        "next_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Action"
        },
        "outcome": {
          "$ref": "#/$defs/ReviewOutcome"
        },
        "pipeline_identity": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Pipeline Identity",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "repository_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Repository Id",
          "type": "string"
        },
        "retry_count": {
          "minimum": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "standards_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Standards Digest",
          "type": "string"
        },
        "status_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Status Id",
          "type": "string"
        },
        "suspected_component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suspected Component"
        },
        "tested_snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tested Snapshot Id",
          "type": "string"
        },
        "trust_registry_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trust Registry Digest",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "status_id",
        "recorded_at",
        "repository_id",
        "tested_snapshot_id",
        "pipeline_identity",
        "standards_digest",
        "trust_registry_digest",
        "integrity_check",
        "outcome",
        "diagnostic_reference",
        "retry_count"
      ],
      "title": "BuildStatus",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": true,
      "properties": {
        "category": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/FindingState",
          "default": "open"
        },
        "evidence_reference": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "finding_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Finding Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "rationale": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "recommendation": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Recommendation",
          "type": "string"
        },
        "severity": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "severity",
        "locator",
        "category",
        "rationale",
        "recommendation",
        "evidence_reference"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingDisposition": {
      "additionalProperties": true,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "finding_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Finding Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/FindingState"
        },
        "rationale": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "outcome",
        "rationale",
        "evidence"
      ],
      "title": "FindingDisposition",
      "type": "object"
    },
    "FindingState": {
      "enum": [
        "open",
        "remediated",
        "not_applicable_or_invalid"
      ],
      "title": "FindingState",
      "type": "string"
    },
    "IndependentAudit": {
      "additionalProperties": true,
      "properties": {
        "audit_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Audit Id",
          "type": "string"
        },
        "auditor_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Auditor Id",
          "type": "string"
        },
        "author_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Author Ids",
          "type": "array"
        },
        "candidate_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Digest",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "dispositions": {
          "items": {
            "$ref": "#/$defs/FindingDisposition"
          },
          "title": "Dispositions",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "milestone_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Milestone Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/ReviewOutcome"
        },
        "response_destination": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Response Destination",
          "type": "string"
        },
        "reviewer_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Reviewer Ids",
          "type": "array"
        },
        "schema_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "traced_references": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "title": "Traced References",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "audit_id",
        "milestone_id",
        "author_ids",
        "reviewer_ids",
        "auditor_id",
        "candidate_digest",
        "traced_references",
        "findings",
        "dispositions",
        "outcome",
        "completed_at",
        "response_destination"
      ],
      "title": "IndependentAudit",
      "type": "object"
    },
    "QualityEngineeringReport": {
      "additionalProperties": true,
      "properties": {
        "acceptance_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Acceptance Ids",
          "type": "array"
        },
        "change_set_reference": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "commands": {
          "items": {
            "type": "string"
          },
          "title": "Commands",
          "type": "array"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "exclusions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Exclusions",
          "type": "object"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "graph_confidence": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Graph Confidence",
          "type": "string"
        },
        "graph_fresh": {
          "title": "Graph Fresh",
          "type": "boolean"
        },
        "graph_reference": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "milestone_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Milestone Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/AssuranceOutcome"
        },
        "prior_report_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Prior Report Id"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Project Id",
          "type": "string"
        },
        "report_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Report Id",
          "type": "string"
        },
        "residual_unknowns": {
          "items": {
            "type": "string"
          },
          "title": "Residual Unknowns",
          "type": "array"
        },
        "run_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Session Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "task_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Task Ids",
          "type": "array"
        },
        "tested_snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tested Snapshot Id",
          "type": "string"
        },
        "touchpoints": {
          "items": {
            "$ref": "#/$defs/TouchpointResult"
          },
          "minItems": 1,
          "title": "Touchpoints",
          "type": "array"
        },
        "verification_scope": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Verification Scope",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "report_id",
        "project_id",
        "run_id",
        "session_id",
        "milestone_id",
        "task_ids",
        "started_at",
        "completed_at",
        "prior_report_id",
        "tested_snapshot_id",
        "change_set_reference",
        "graph_reference",
        "graph_fresh",
        "graph_confidence",
        "touchpoints",
        "acceptance_ids",
        "verification_scope",
        "environment",
        "commands",
        "exclusions",
        "residual_unknowns",
        "findings",
        "limitations",
        "outcome"
      ],
      "title": "QualityEngineeringReport",
      "type": "object"
    },
    "ReviewOutcome": {
      "enum": [
        "pass",
        "revision_required"
      ],
      "title": "ReviewOutcome",
      "type": "string"
    },
    "TouchpointResult": {
      "additionalProperties": true,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "kind": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/AssuranceOutcome"
        },
        "touchpoint_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Touchpoint Id",
          "type": "string"
        }
      },
      "required": [
        "touchpoint_id",
        "kind",
        "evidence",
        "outcome"
      ],
      "title": "TouchpointResult",
      "type": "object"
    }
  },
  "$id": "https://schemas.agentic-studio.local/v1/milestone-review.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "audit": {
      "$ref": "#/$defs/IndependentAudit"
    },
    "build_status": {
      "$ref": "#/$defs/BuildStatus"
    },
    "candidate_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Digest",
      "type": "string"
    },
    "code_review_references": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Code Review References",
      "type": "array"
    },
    "contract_reference": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "milestone_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Milestone Id",
      "type": "string"
    },
    "open_comments": {
      "items": {
        "type": "string"
      },
      "title": "Open Comments",
      "type": "array"
    },
    "orchestrator_dispositions": {
      "items": {
        "$ref": "#/$defs/FindingDisposition"
      },
      "title": "Orchestrator Dispositions",
      "type": "array"
    },
    "outcome": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Outcome",
      "type": "string"
    },
    "progress_reference": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "quality_report": {
      "$ref": "#/$defs/QualityEngineeringReport"
    },
    "readiness_reference": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "review_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Review Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "milestone_id",
    "candidate_digest",
    "readiness_reference",
    "contract_reference",
    "progress_reference",
    "code_review_references",
    "build_status",
    "quality_report",
    "audit",
    "orchestrator_dispositions",
    "open_comments",
    "outcome"
  ],
  "title": "MilestoneReview",
  "type": "object"
}
