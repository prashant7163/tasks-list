{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": true,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^1\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "locator",
        "schema_version",
        "sha256"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "AssuranceOutcome": {
      "enum": [
        "pass",
        "revision_required",
        "blocked_inconclusive"
      ],
      "title": "AssuranceOutcome",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": true,
      "properties": {
        "category": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/FindingState",
          "default": "open"
        },
        "evidence_reference": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "finding_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Finding Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "rationale": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "recommendation": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Recommendation",
          "type": "string"
        },
        "severity": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "severity",
        "locator",
        "category",
        "rationale",
        "recommendation",
        "evidence_reference"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingState": {
      "enum": [
        "open",
        "remediated",
        "not_applicable_or_invalid"
      ],
      "title": "FindingState",
      "type": "string"
    },
    "TouchpointResult": {
      "additionalProperties": true,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "kind": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/AssuranceOutcome"
        },
        "touchpoint_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Touchpoint Id",
          "type": "string"
        }
      },
      "required": [
        "touchpoint_id",
        "kind",
        "evidence",
        "outcome"
      ],
      "title": "TouchpointResult",
      "type": "object"
    }
  },
  "$id": "https://schemas.agentic-studio.local/v1/quality-engineering-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "acceptance_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Acceptance Ids",
      "type": "array"
    },
    "change_set_reference": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "commands": {
      "items": {
        "type": "string"
      },
      "title": "Commands",
      "type": "array"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "environment": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Environment",
      "type": "object"
    },
    "exclusions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Exclusions",
      "type": "object"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "graph_confidence": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Graph Confidence",
      "type": "string"
    },
    "graph_fresh": {
      "title": "Graph Fresh",
      "type": "boolean"
    },
    "graph_reference": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "milestone_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Milestone Id",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/AssuranceOutcome"
    },
    "prior_report_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Prior Report Id"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Project Id",
      "type": "string"
    },
    "report_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Report Id",
      "type": "string"
    },
    "residual_unknowns": {
      "items": {
        "type": "string"
      },
      "title": "Residual Unknowns",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Session Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "task_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Task Ids",
      "type": "array"
    },
    "tested_snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Tested Snapshot Id",
      "type": "string"
    },
    "touchpoints": {
      "items": {
        "$ref": "#/$defs/TouchpointResult"
      },
      "minItems": 1,
      "title": "Touchpoints",
      "type": "array"
    },
    "verification_scope": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Verification Scope",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "report_id",
    "project_id",
    "run_id",
    "session_id",
    "milestone_id",
    "task_ids",
    "started_at",
    "completed_at",
    "prior_report_id",
    "tested_snapshot_id",
    "change_set_reference",
    "graph_reference",
    "graph_fresh",
    "graph_confidence",
    "touchpoints",
    "acceptance_ids",
    "verification_scope",
    "environment",
    "commands",
    "exclusions",
    "residual_unknowns",
    "findings",
    "limitations",
    "outcome"
  ],
  "title": "QualityEngineeringReport",
  "type": "object"
}
