{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": true,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^1\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "locator",
        "schema_version",
        "sha256"
      ],
      "title": "ArtifactReference",
      "type": "object"
    }
  },
  "$id": "https://schemas.agentic-studio.local/v1/run-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "active_milestone_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Active Milestone Id"
    },
    "active_references": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Active References",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "current_phase": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Current Phase",
      "type": "string"
    },
    "current_source_revision": {
      "pattern": "^[0-9a-f]{40,64}$",
      "title": "Current Source Revision",
      "type": "string"
    },
    "last_event_sequence": {
      "minimum": 0,
      "title": "Last Event Sequence",
      "type": "integer"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Project Id",
      "type": "string"
    },
    "provider_trace_ids": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Provider Trace Ids",
      "type": "object"
    },
    "retry_counters": {
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$": {
          "type": "integer"
        }
      },
      "title": "Retry Counters",
      "type": "object"
    },
    "run_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_runtime": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Selected Runtime",
      "type": "string"
    },
    "task_states": {
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$": {
          "type": "string"
        }
      },
      "title": "Task States",
      "type": "object"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "run_id",
    "selected_runtime",
    "current_phase",
    "active_milestone_id",
    "current_source_revision",
    "active_references",
    "task_states",
    "retry_counters",
    "provider_trace_ids",
    "last_event_sequence",
    "created_at",
    "updated_at"
  ],
  "title": "RunRecord",
  "type": "object"
}
