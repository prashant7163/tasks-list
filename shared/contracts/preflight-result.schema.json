{
  "$defs": {
    "PreflightCheck": {
      "additionalProperties": true,
      "properties": {
        "check_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Check Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/PreflightOutcome"
        },
        "owner": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "remediation": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remediation"
        },
        "scope": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "scope",
        "outcome",
        "summary",
        "owner"
      ],
      "title": "PreflightCheck",
      "type": "object"
    },
    "PreflightOutcome": {
      "enum": [
        "pass",
        "warning",
        "affected_scope_blocker",
        "not_applicable"
      ],
      "title": "PreflightOutcome",
      "type": "string"
    }
  },
  "$id": "https://schemas.agentic-studio.local/v1/preflight-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/PreflightCheck"
      },
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Project Id",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "result_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Result Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "secret_reference_names": {
      "items": {
        "type": "string"
      },
      "title": "Secret Reference Names",
      "type": "array"
    },
    "snapshot_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Digest",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "result_id",
    "project_id",
    "snapshot_digest",
    "recorded_at",
    "checks",
    "secret_reference_names"
  ],
  "title": "PreflightResult",
  "type": "object"
}
