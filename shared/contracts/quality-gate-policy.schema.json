{
  "$defs": {
    "QualityGate": {
      "additionalProperties": true,
      "properties": {
        "blocking": {
          "default": true,
          "title": "Blocking",
          "type": "boolean"
        },
        "gate_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Gate Id",
          "type": "string"
        },
        "required_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Required Evidence",
          "type": "array"
        },
        "responsible_role": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Responsible Role",
          "type": "string"
        }
      },
      "required": [
        "gate_id",
        "responsible_role",
        "required_evidence"
      ],
      "title": "QualityGate",
      "type": "object"
    }
  },
  "$id": "https://schemas.agentic-studio.local/v1/quality-gate-policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "gates": {
      "items": {
        "$ref": "#/$defs/QualityGate"
      },
      "minItems": 1,
      "title": "Gates",
      "type": "array"
    },
    "policy_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Policy Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "gates"
  ],
  "title": "QualityGatePolicy",
  "type": "object"
}
