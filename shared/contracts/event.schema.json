{
  "$id": "https://schemas.agentic-studio.local/v1/event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "actor_role": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Actor Role",
      "type": "string"
    },
    "adapter_name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Adapter Name",
      "type": "string"
    },
    "agent_instance_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Agent Instance Id"
    },
    "attempt_number": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt Number"
    },
    "event_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event Hash"
    },
    "event_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)+$",
      "title": "Event Type",
      "type": "string"
    },
    "milestone_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Milestone Id"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "previous_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Hash"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Project Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "session_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Session Id"
    },
    "task_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Task Id"
    },
    "trace_correlation_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Trace Correlation Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "sequence",
    "event_id",
    "occurred_at",
    "project_id",
    "run_id",
    "session_id",
    "milestone_id",
    "task_id",
    "agent_instance_id",
    "actor_role",
    "event_type",
    "adapter_name",
    "trace_correlation_id",
    "payload"
  ],
  "title": "Event",
  "type": "object"
}
