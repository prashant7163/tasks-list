        "acceptance_criterion_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criterion Ids",
          "type": "array"
        },
        "requirement_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Requirement Id",
          "type": "string"
        },
        "traceability_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Traceability Id",
          "type": "string"
        }
      },
      "required": [
        "traceability_id",
        "requirement_id",
        "acceptance_criterion_ids"
      ],
      "title": "TraceabilityEntry",
      "type": "object"
    },
    "VerificationStep": {
      "additionalProperties": true,
      "properties": {
        "applicability_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applicability Reason"
        },
        "applicable": {
          "default": true,
          "title": "Applicable",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/TaskKind"
        },
        "producer_task_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Producer Task Ids",
          "type": "array"
        },
        "reviewer_instance_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Reviewer Instance Id",
          "type": "string"
        },
        "reviewer_role": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Reviewer Role",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "verification_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Verification Id",
          "type": "string"
        }
      },
      "required": [
        "verification_id",
        "kind",
        "title",
        "reviewer_role",
        "reviewer_instance_id",
        "producer_task_ids"
      ],
      "title": "VerificationStep",
      "type": "object"
    },
    "WorkspaceAllocation": {
      "additionalProperties": true,
      "properties": {
        "isolation_kind": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Isolation Kind",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "isolation_kind",
        "locator"
      ],
      "title": "WorkspaceAllocation",
      "type": "object"
    }
  },
  "$id": "https://schemas.agentic-studio.local/v1/milestone-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "milestones": {
      "items": {
        "$ref": "#/$defs/MilestoneDefinition"
      },
      "minItems": 1,
      "title": "Milestones",
      "type": "array"
    },
    "plan_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Plan Id",
      "type": "string"
    },
    "project_specification": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectSpecification"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_specification_reference": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "schema_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "project_specification",
    "project_specification_reference",
    "milestones"
  ],
  "title": "MilestonePlan",
  "type": "object",
  "x-agentic-studio-runtime-validation": {
    "canonical_validator": "MilestonePlan.validate_plan",
    "required_rules": [
      "approved specification/reference identity and canonical digest binding",
      "milestone-local requirement, task, and verification coverage",
      "mandatory gate, role independence, workspace ownership, and dependency DAG validation"
    ]
  }
}
