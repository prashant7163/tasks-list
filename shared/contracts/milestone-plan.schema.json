          "type": "string"
        },
        "persona_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Persona Id",
          "type": "string"
        },
        "steps": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "journey_id",
        "persona_id",
        "outcome",
        "steps"
      ],
      "title": "Journey",
      "type": "object"
    },
    "MilestoneBoundary": {
      "enum": [
        "single_role",
        "cross_boundary"
      ],
      "title": "MilestoneBoundary",
      "type": "string"
    },
    "MilestoneDefinition": {
      "additionalProperties": true,
      "properties": {
        "affected_roles": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Affected Roles",
          "type": "array"
        },
        "boundary": {
          "$ref": "#/$defs/MilestoneBoundary"
        },
        "exit_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Exit Criteria",
          "type": "array"
        },
        "milestone_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Milestone Id",
          "type": "string"
        },
        "objective": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "ordinal": {
          "minimum": 1,
          "title": "Ordinal",
          "type": "integer"
        },
        "proposed_demo": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Proposed Demo",
          "type": "string"
        },
        "requirement_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        },
        "risk_level": {
          "$ref": "#/$defs/RiskLevel"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/PlannedTask"
          },
          "minItems": 1,
          "title": "Tasks",
          "type": "array"
        },
        "verification_steps": {
          "items": {
            "$ref": "#/$defs/VerificationStep"
          },
          "minItems": 1,
          "title": "Verification Steps",
          "type": "array"
        }
      },
      "required": [
        "milestone_id",
        "ordinal",
        "objective",
        "requirement_ids",
        "exit_criteria",
        "proposed_demo",
        "risk_level",
        "boundary",
        "affected_roles",
        "tasks",
        "verification_steps"
      ],
      "title": "MilestoneDefinition",
      "type": "object"
    },
