        },
        "system_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "System Id",
          "type": "string"
        }
      },
      "required": [
        "system_id",
        "name",
        "purpose",
        "data_classifications"
      ],
      "title": "ExternalSystem",
      "type": "object"
    },
    "Goal": {
      "additionalProperties": true,
      "properties": {
        "goal_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Goal Id",
          "type": "string"
        },
        "statement": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "goal_id",
        "statement"
      ],
      "title": "Goal",
      "type": "object"
    },
    "Journey": {
      "additionalProperties": true,
      "properties": {
        "journey_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
