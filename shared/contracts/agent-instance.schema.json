{
  "$defs": {
    "AgentLifecycle": {
      "enum": [
        "pending",
        "active",
        "completed",
        "interrupted",
        "retired"
      ],
      "title": "AgentLifecycle",
      "type": "string"
    },
    "Approval": {
      "additionalProperties": true,
      "properties": {
        "approval_id": {
          "pattern": "^apr-[a-z0-9][a-z0-9-]{2,63}$",
          "title": "Approval Id",
          "type": "string"
        },
        "comment": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decided_by": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Decided By",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/ApprovalDecision"
        },
        "schema_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "subject_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Subject Digest",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        },
        "subject_type": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Subject Type",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "approval_id",
        "subject_type",
        "subject_id",
        "subject_digest",
        "decision",
        "decided_by",
        "decided_at"
      ],
      "title": "Approval",
      "type": "object"
    },
    "ApprovalDecision": {
      "enum": [
        "approved",
        "changes_requested",
        "rejected"
      ],
      "title": "ApprovalDecision",
      "type": "string"
    },
    "ArtifactReference": {
      "additionalProperties": true,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^1\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "locator",
        "schema_version",
        "sha256"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "BudgetEnvelope": {
      "additionalProperties": true,
      "properties": {
        "max_concurrency": {
          "exclusiveMinimum": 0,
          "title": "Max Concurrency",
          "type": "integer"
        },
        "max_cost_units": {
          "exclusiveMinimum": 0,
          "title": "Max Cost Units",
          "type": "integer"
        },
        "max_duration_minutes": {
          "exclusiveMinimum": 0,
          "title": "Max Duration Minutes",
          "type": "integer"
        }
      },
      "required": [
        "max_concurrency",
        "max_cost_units",
        "max_duration_minutes"
      ],
      "title": "BudgetEnvelope",
      "type": "object"
    },
    "ContextAccessMode": {
      "enum": [
        "minimum_necessary"
      ],
      "title": "ContextAccessMode",
      "type": "string"
    },
    "LeaseEnvelope": {
      "additionalProperties": true,
      "properties": {
        "cleanup_condition": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Cleanup Condition",
          "type": "string"
        },
        "handoff_condition": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Handoff Condition",
          "type": "string"
        },
        "lifetime_minutes": {
          "exclusiveMinimum": 0,
          "title": "Lifetime Minutes",
          "type": "integer"
        }
      },
      "required": [
        "lifetime_minutes",
        "handoff_condition",
        "cleanup_condition"
      ],
      "title": "LeaseEnvelope",
      "type": "object"
    },
    "PermissionEnvelope": {
      "additionalProperties": true,
      "properties": {
        "data_allowlist": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Data Allowlist",
          "type": "array"
        },
        "tool_allowlist": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Tool Allowlist",
          "type": "array"
        }
      },
      "required": [
        "data_allowlist",
        "tool_allowlist"
      ],
      "title": "PermissionEnvelope",
      "type": "object"
    },
    "ProviderModelConstraints": {
      "additionalProperties": true,
      "properties": {
        "model_allowlist": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Model Allowlist",
          "type": "array"
        },
        "provider_allowlist": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Provider Allowlist",
          "type": "array"
        }
      },
      "required": [
        "provider_allowlist",
        "model_allowlist"
      ],
      "title": "ProviderModelConstraints",
      "type": "object"
    },
    "Specialization": {
      "additionalProperties": true,
      "properties": {
        "parameters": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Parameters",
          "type": "array"
        },
        "specialization_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Specialization Id",
          "type": "string"
        }
      },
      "required": [
        "specialization_id",
        "parameters"
      ],
      "title": "Specialization",
      "type": "object"
    },
    "WorkspaceAllocation": {
      "additionalProperties": true,
      "properties": {
        "isolation_kind": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Isolation Kind",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "isolation_kind",
        "locator"
      ],
      "title": "WorkspaceAllocation",
      "type": "object"
    }
  },
  "$id": "https://schemas.agentic-studio.local/v1/agent-instance.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "agent_instance_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Agent Instance Id",
      "type": "string"
    },
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/Approval"
        },
        {
          "type": "null"
        }
      ]
    },
    "budget": {
      "$ref": "#/$defs/BudgetEnvelope"
    },
    "context_access_mode": {
      "$ref": "#/$defs/ContextAccessMode"
    },
    "contract_references": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Contract References",
      "type": "array"
    },
    "deliverable": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Deliverable",
      "type": "string"
    },
    "dependency_references": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Dependency References",
      "type": "array"
    },
    "lease": {
      "$ref": "#/$defs/LeaseEnvelope"
    },
    "lifecycle": {
      "$ref": "#/$defs/AgentLifecycle"
    },
    "minimum_context_pack_reference": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "overlap_check": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Overlap Check",
      "type": "string"
    },
    "ownership_boundary": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Ownership Boundary",
      "type": "string"
    },
    "permissions": {
      "$ref": "#/$defs/PermissionEnvelope"
    },
    "provider_model": {
      "$ref": "#/$defs/ProviderModelConstraints"
    },
    "reason_trigger": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Reason Trigger",
      "type": "string"
    },
    "replacement_for_instance_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replacement For Instance Id"
    },
    "role_template_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Role Template Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Scope",
      "type": "string"
    },
    "specialization": {
      "$ref": "#/$defs/Specialization"
    },
    "work_package_references": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Work Package References",
      "type": "array"
    },
    "workspace": {
      "$ref": "#/$defs/WorkspaceAllocation"
    }
  },
  "required": [
    "schema_version",
    "role_template_id",
    "specialization",
    "scope",
    "deliverable",
    "ownership_boundary",
    "overlap_check",
    "context_access_mode",
    "permissions",
    "workspace",
    "provider_model",
    "budget",
    "lease",
    "reason_trigger",
    "dependency_references",
    "contract_references",
    "work_package_references",
    "minimum_context_pack_reference",
    "agent_instance_id",
    "lifecycle",
    "approval"
  ],
  "title": "AgentInstance",
  "type": "object",
  "x-agentic-studio-runtime-validation": {
    "canonical_validator": "AgentInstance.validate_lifecycle_and_approval",
    "required_rules": [
      "authoritative readiness/control-plane state confirms predecessor instance existence",
      "authoritative readiness/control-plane state confirms predecessor approval eligibility"
    ]
  }
}
