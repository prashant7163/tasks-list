{
  "$defs": {
    "AgentInstance": {
      "additionalProperties": true,
      "properties": {
        "agent_instance_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Agent Instance Id",
          "type": "string"
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Approval"
            },
            {
              "type": "null"
            }
          ]
        },
        "budget": {
          "$ref": "#/$defs/BudgetEnvelope"
        },
        "context_access_mode": {
          "$ref": "#/$defs/ContextAccessMode"
        },
        "contract_references": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Contract References",
          "type": "array"
        },
        "deliverable": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Deliverable",
          "type": "string"
        },
        "dependency_references": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Dependency References",
          "type": "array"
        },
        "lease": {
          "$ref": "#/$defs/LeaseEnvelope"
        },
        "lifecycle": {
          "$ref": "#/$defs/AgentLifecycle"
        },
        "minimum_context_pack_reference": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "overlap_check": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Overlap Check",
          "type": "string"
        },
        "ownership_boundary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Ownership Boundary",
          "type": "string"
        },
        "permissions": {
          "$ref": "#/$defs/PermissionEnvelope"
        },
        "provider_model": {
          "$ref": "#/$defs/ProviderModelConstraints"
        },
        "reason_trigger": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason Trigger",
          "type": "string"
        },
        "replacement_for_instance_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replacement For Instance Id"
        },
        "role_template_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Role Template Id",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "specialization": {
          "$ref": "#/$defs/Specialization"
        },
        "work_package_references": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Work Package References",
          "type": "array"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceAllocation"
        }
      },
      "required": [
        "schema_version",
        "role_template_id",
        "specialization",
        "scope",
        "deliverable",
        "ownership_boundary",
        "overlap_check",
        "context_access_mode",
        "permissions",
        "workspace",
        "provider_model",
        "budget",
        "lease",
        "reason_trigger",
        "dependency_references",
        "contract_references",
        "work_package_references",
        "minimum_context_pack_reference",
        "agent_instance_id",
        "lifecycle",
        "approval"
      ],
      "title": "AgentInstance",
      "type": "object"
    },
    "AgentLifecycle": {
      "enum": [
        "pending",
        "active",
        "completed",
        "interrupted",
        "retired"
      ],
      "title": "AgentLifecycle",
      "type": "string"
    },
    "ApplicabilityDecision": {
      "enum": [
        "applicable",
        "not_applicable"
      ],
      "title": "ApplicabilityDecision",
      "type": "string"
    },
    "Approval": {
      "additionalProperties": true,
      "properties": {
        "approval_id": {
          "pattern": "^apr-[a-z0-9][a-z0-9-]{2,63}$",
          "title": "Approval Id",
          "type": "string"
        },
        "comment": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decided_by": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Decided By",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/ApprovalDecision"
        },
        "schema_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "subject_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Subject Digest",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        },
        "subject_type": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Subject Type",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "approval_id",
        "subject_type",
        "subject_id",
        "subject_digest",
        "decision",
        "decided_by",
        "decided_at"
      ],
      "title": "Approval",
      "type": "object"
    },
    "ApprovalDecision": {
      "enum": [
        "approved",
        "changes_requested",
        "rejected"
      ],
      "title": "ApprovalDecision",
      "type": "string"
    },
    "ArtifactReference": {
      "additionalProperties": true,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^1\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "locator",
        "schema_version",
        "sha256"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "BudgetEnvelope": {
      "additionalProperties": true,
      "properties": {
        "max_concurrency": {
          "exclusiveMinimum": 0,
          "title": "Max Concurrency",
          "type": "integer"
        },
        "max_cost_units": {
          "exclusiveMinimum": 0,
          "title": "Max Cost Units",
          "type": "integer"
        },
        "max_duration_minutes": {
          "exclusiveMinimum": 0,
          "title": "Max Duration Minutes",
          "type": "integer"
        }
      },
      "required": [
        "max_concurrency",
        "max_cost_units",
        "max_duration_minutes"
      ],
      "title": "BudgetEnvelope",
      "type": "object"
    },
    "ContextAccessMode": {
      "enum": [
        "minimum_necessary"
      ],
      "title": "ContextAccessMode",
      "type": "string"
    },
    "DoctorResultEvidence": {
      "additionalProperties": true,
      "properties": {
        "decision": {
          "$ref": "#/$defs/ApplicabilityDecision"
        },
        "evidence_references": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence References",
          "type": "array"
        },
        "rationale": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "redacted": {
          "default": true,
          "title": "Redacted",
          "type": "boolean"
        }
      },
      "required": [
        "decision",
        "rationale",
        "evidence_references"
      ],
      "title": "DoctorResultEvidence",
      "type": "object"
    },
    "EffectiveStandardsEvidence": {
      "additionalProperties": true,
      "properties": {
        "applicable_standard_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Applicable Standard Ids",
          "type": "array"
        },
        "decision": {
          "$ref": "#/$defs/ApplicabilityDecision"
        },
        "evidence_references": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence References",
          "type": "array"
        },
        "exception_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Exception Ids",
          "type": "array"
        },
        "rationale": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "rationale",
        "evidence_references"
      ],
      "title": "EffectiveStandardsEvidence",
      "type": "object"
    },
    "IntegrationTestPlanEvidence": {
      "additionalProperties": true,
      "properties": {
        "decision": {
          "$ref": "#/$defs/ApplicabilityDecision"
        },
        "evidence_references": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence References",
          "type": "array"
        },
        "integration_point_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Integration Point Ids",
          "type": "array"
        },
        "rationale": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "rationale",
        "evidence_references"
      ],
      "title": "IntegrationTestPlanEvidence",
      "type": "object"
    },
    "InterfaceDecision": {
      "additionalProperties": true,
      "properties": {
        "example": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Example",
          "type": "string"
        },
        "integration_reference": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "interface_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Interface Id",
          "type": "string"
        },
        "owner_instance_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Owner Instance Id",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "work_package_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Work Package Id",
          "type": "string"
        }
      },
      "required": [
        "interface_id",
        "owner_instance_id",
        "work_package_id",
        "integration_reference",
        "reference",
        "example"
      ],
      "title": "InterfaceDecision",
      "type": "object"
    },
    "LeaseEnvelope": {
      "additionalProperties": true,
      "properties": {
        "cleanup_condition": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Cleanup Condition",
          "type": "string"
        },
        "handoff_condition": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Handoff Condition",
          "type": "string"
        },
        "lifetime_minutes": {
          "exclusiveMinimum": 0,
          "title": "Lifetime Minutes",
          "type": "integer"
        }
      },
      "required": [
        "lifetime_minutes",
        "handoff_condition",
        "cleanup_condition"
      ],
      "title": "LeaseEnvelope",
      "type": "object"
    },
    "MilestoneBoundary": {
      "enum": [
        "single_role",
        "cross_boundary"
      ],
      "title": "MilestoneBoundary",
      "type": "string"
    },
    "PermissionEnvelope": {
      "additionalProperties": true,
      "properties": {
        "data_allowlist": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Data Allowlist",
          "type": "array"
        },
        "tool_allowlist": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Tool Allowlist",
          "type": "array"
        }
      },
      "required": [
        "data_allowlist",
        "tool_allowlist"
      ],
      "title": "PermissionEnvelope",
      "type": "object"
    },
    "ProviderModelConstraints": {
      "additionalProperties": true,
      "properties": {
        "model_allowlist": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Model Allowlist",
          "type": "array"
        },
        "provider_allowlist": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Provider Allowlist",
          "type": "array"
        }
      },
      "required": [
        "provider_allowlist",
        "model_allowlist"
      ],
      "title": "ProviderModelConstraints",
      "type": "object"
    },
    "ReadinessOutcome": {
      "enum": [
        "ready",
        "revision_required"
      ],
      "title": "ReadinessOutcome",
      "type": "string"
    },
    "RoleApplicability": {
      "additionalProperties": true,
      "properties": {
        "decision": {
          "$ref": "#/$defs/ApplicabilityDecision"
        },
        "evidence_reference": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "owner_instance_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Instance Id"
        },
        "rationale": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "role": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "decision",
        "rationale",
        "evidence_reference"
      ],
      "title": "RoleApplicability",
      "type": "object"
    },
    "RoleSkillIndependenceEvidence": {
      "additionalProperties": true,
      "properties": {
        "covered_role_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Covered Role Ids",
          "type": "array"
        },
        "decision": {
          "$ref": "#/$defs/ApplicabilityDecision"
        },
        "evidence_references": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence References",
          "type": "array"
        },
        "rationale": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "rationale",
        "evidence_references"
      ],
      "title": "RoleSkillIndependenceEvidence",
      "type": "object"
    },
    "RollingProgressEvidence": {
      "additionalProperties": true,
      "properties": {
        "decision": {
          "$ref": "#/$defs/ApplicabilityDecision"
        },
        "evidence_references": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence References",
          "type": "array"
        },
        "rationale": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "rationale",
        "evidence_references"
      ],
      "title": "RollingProgressEvidence",
      "type": "object"
    },
    "Specialization": {
      "additionalProperties": true,
      "properties": {
        "parameters": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Parameters",
          "type": "array"
        },
        "specialization_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Specialization Id",
          "type": "string"
        }
      },
      "required": [
        "specialization_id",
        "parameters"
      ],
      "title": "Specialization",
      "type": "object"
    },
    "ThreatDecisionEvidence": {
      "additionalProperties": true,
      "properties": {
        "control_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Control Ids",
          "type": "array"
        },
        "decision": {
          "$ref": "#/$defs/ApplicabilityDecision"
        },
        "evidence_references": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence References",
          "type": "array"
        },
        "rationale": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "rationale",
        "evidence_references"
      ],
      "title": "ThreatDecisionEvidence",
      "type": "object"
    },
    "TrustedCapabilityEvidence": {
      "additionalProperties": true,
      "properties": {
        "capability_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Capability Ids",
          "type": "array"
        },
        "decision": {
          "$ref": "#/$defs/ApplicabilityDecision"
        },
        "evidence_references": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence References",
          "type": "array"
        },
        "rationale": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "rationale",
        "evidence_references"
      ],
      "title": "TrustedCapabilityEvidence",
      "type": "object"
    },
    "WorkPackage": {
      "additionalProperties": true,
      "properties": {
        "deliverable": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Deliverable",
          "type": "string"
        },
        "dependency_work_package_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Dependency Work Package Ids",
          "type": "array"
        },
        "integration_references": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Integration References",
          "type": "array"
        },
        "owned_locators": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Owned Locators",
          "type": "array"
        },
        "owner_instance_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Owner Instance Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "work_package_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Work Package Id",
          "type": "string"
        }
      },
      "required": [
        "work_package_id",
        "owner_instance_id",
        "owned_locators",
        "dependency_work_package_ids",
        "sequence",
        "deliverable",
        "integration_references"
      ],
      "title": "WorkPackage",
      "type": "object"
    },
    "WorkspaceAllocation": {
      "additionalProperties": true,
      "properties": {
        "isolation_kind": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Isolation Kind",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "isolation_kind",
        "locator"
      ],
      "title": "WorkspaceAllocation",
      "type": "object"
    }
  },
  "$id": "https://schemas.agentic-studio.local/v1/milestone-readiness.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "acceptance_criterion_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Acceptance Criterion Ids",
      "type": "array"
    },
    "affected_roles": {
      "items": {
        "type": "string"
      },
      "title": "Affected Roles",
      "type": "array"
    },
    "approved_instances": {
      "items": {
        "$ref": "#/$defs/AgentInstance"
      },
      "title": "Approved Instances",
      "type": "array"
    },
