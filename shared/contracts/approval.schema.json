{
  "$defs": {
    "ApprovalDecision": {
      "enum": [
        "approved",
        "changes_requested",
        "rejected"
      ],
      "title": "ApprovalDecision",
      "type": "string"
    }
  },
  "$id": "https://schemas.agentic-studio.local/v1/approval.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "approval_id": {
      "pattern": "^apr-[a-z0-9][a-z0-9-]{2,63}$",
      "title": "Approval Id",
      "type": "string"
    },
    "comment": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comment"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decided_by": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Decided By",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/ApprovalDecision"
    },
    "schema_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "subject_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Subject Digest",
      "type": "string"
    },
    "subject_id": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Subject Id",
      "type": "string"
    },
    "subject_type": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Subject Type",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "approval_id",
    "subject_type",
    "subject_id",
    "subject_digest",
    "decision",
    "decided_by",
    "decided_at"
  ],
  "title": "Approval",
  "type": "object"
}
