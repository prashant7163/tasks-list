{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": true,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^1\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "locator",
        "schema_version",
        "sha256"
      ],
      "title": "ArtifactReference",
      "type": "object"
    }
  },
  "$id": "https://schemas.agentic-studio.local/v1/standards-exception.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "approval_reference": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "compensating_controls": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Compensating Controls",
      "type": "array"
    },
    "evidence_references": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Evidence References",
      "type": "array"
    },
    "exception_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Exception Id",
      "type": "string"
    },
    "next_review_trigger": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Next Review Trigger",
      "type": "string"
    },
    "owner": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Owner",
      "type": "string"
    },
    "rationale": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "rule_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Rule Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Scope",
      "type": "string"
    },
    "status": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "exception_id",
    "rule_id",
    "scope",
    "owner",
    "rationale",
    "evidence_references",
    "compensating_controls",
    "approval_reference",
    "next_review_trigger",
    "status"
  ],
  "title": "StandardsException",
  "type": "object"
}
