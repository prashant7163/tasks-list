{
  "$defs": {
    "RoleCapabilityDefinition": {
      "additionalProperties": true,
      "properties": {
        "applicable_roles": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Applicable Roles",
          "type": "array"
        },
        "capability_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Capability Id",
          "type": "string"
        },
        "definition": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Definition",
          "type": "string"
        },
        "enforcement": {
          "items": {
            "$ref": "#/$defs/RoleCapabilityEnforcement"
          },
          "minItems": 1,
          "title": "Enforcement",
          "type": "array"
        },
        "instruction": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RoleCapabilityKind"
        }
      },
      "required": [
        "capability_id",
        "kind",
        "definition",
        "instruction",
        "enforcement",
        "applicable_roles"
      ],
      "title": "RoleCapabilityDefinition",
      "type": "object"
    },
    "RoleCapabilityEnforcement": {
      "enum": [
        "agent_instruction",
        "control_plane",
        "human_gate",
        "runtime_permission"
      ],
      "title": "RoleCapabilityEnforcement",
      "type": "string"
    },
    "RoleCapabilityKind": {
      "enum": [
        "authority",
        "boundary"
      ],
      "title": "RoleCapabilityKind",
      "type": "string"
    }
  },
  "$id": "https://schemas.agentic-studio.local/v1/role-capability-registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "capabilities": {
      "items": {
        "$ref": "#/$defs/RoleCapabilityDefinition"
      },
      "minItems": 1,
      "title": "Capabilities",
      "type": "array"
    },
    "registry_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Registry Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "registry_id",
    "capabilities"
  ],
  "title": "RoleCapabilityRegistry",
  "type": "object"
}
