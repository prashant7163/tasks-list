{
  "$id": "https://schemas.agentic-studio.local/v1/prompt-template.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "completion_condition": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Completion Condition",
      "type": "string"
    },
    "prohibited_content": {
      "items": {
        "type": "string"
      },
      "title": "Prohibited Content",
      "type": "array"
    },
    "required_sections": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Sections",
      "type": "array"
    },
    "schema_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "template_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Template Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "template_id",
    "required_sections",
    "prohibited_content",
    "completion_condition"
  ],
  "title": "PromptTemplate",
  "type": "object"
}
