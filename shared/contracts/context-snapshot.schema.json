{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": true,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^1\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "locator",
        "schema_version",
        "sha256"
      ],
      "title": "ArtifactReference",
      "type": "object"
    }
  },
  "$id": "https://schemas.agentic-studio.local/v1/context-snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "authoritative_references": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Authoritative References",
      "type": "array"
    },
    "context_pack_manifest_reference": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "index_revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Index Revision",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_revision": {
      "pattern": "^[0-9a-f]{40,64}$",
      "title": "Source Revision",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Task Id",
      "type": "string"
    },
    "working_tree_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Working Tree Digest",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "project_id",
    "task_id",
    "source_revision",
    "working_tree_digest",
    "index_revision",
    "authoritative_references",
    "context_pack_manifest_reference"
  ],
  "title": "ContextSnapshot",
  "type": "object"
}
